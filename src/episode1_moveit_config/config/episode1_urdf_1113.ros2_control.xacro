<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="episode1_urdf_1113_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <!-- ros2_control 硬件接口定义：必须是 <robot> 的直接子元素（顶层）。
             Gazebo 进程内的 controller_manager 通过 /robot_description 话题
             收到 URDF 后，用 parse_urdf 读取顶层的 <ros2_control> 标签来初始化
             GazeboSimSystem 硬件接口。若把它嵌套在 <gazebo><plugin> 里，会被
             URDF 解析器当成 gazebo 扩展而忽略，从而报
             "no 'ros2_control' tag found in the URDF"。 -->
        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="joint1">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint1']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint2">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint2']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint3">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint3']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint4">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint4']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint5">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint5']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
            <joint name="joint6">
                <command_interface name="position"/>
                <state_interface name="position">
                    <param name="initial_value">${initial_positions['joint6']}</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>

        <!-- Gazebo 插件：负责 (1) 在 Gazebo 进程内实例化 controller_manager、
             (2) 从 <parameters> 加载控制器配置（update_rate + 控制器定义）。
             硬件接口定义在上面的顶层 <ros2_control> 里，经 /robot_description
             话题送达 Gazebo 内的 controller_manager，二者相互独立。 -->
        <gazebo>
            <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>$(find episode1_moveit_config)/config/ros2_controllers.yaml</parameters>
                <!-- 位置指令接口的比例增益（默认 0.1 太弱，扛不住重力，机械臂抬不起来）。
                     增益越大跟踪越快，但 <=1 才不振荡、<=2 才稳定。
                     joint_velocity = gain * position_error * update_rate（update_rate=100）。 -->
                <position_proportional_gain>0.5</position_proportional_gain>
            </plugin>
        </gazebo>
    </xacro:macro>
</robot>
